{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "gexis/search-state",
	"title": "Search state",
	"category": "theme",
	"icon": "search",
	"description": "The parts of the search screen that depend on the query: suggested searches or the no-results line, the results count, and the results by tag.",
	"textdomain": "gexis",
	"attributes": {
		"part": {
			"type": "string",
			"default": "all",
			"enum": [
				"all",
				"head",
				"count",
				"tags"
			],
			"label": "Part",
			"options": [
				"Everything, in one place",
				"Suggestions or the no-results line",
				"The results count",
				"The results by tag"
			]
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "gexis-blocks-editor",
	"render": "file:./render.php"
}
